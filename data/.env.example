# Variables de entorno del pipeline de datos RehabiAPP (/data)
# Copiar a .env.local para desarrollo y NO incluir en git.

# MongoDB
MONGO_URI=mongodb://localhost:27017/rehabiapp_data
RH_MONGO_POOL_MIN=5
RH_MONGO_POOL_MAX=50
RH_MONGO_POOL_MAX_WAIT_MS=30000
RH_MONGO_POOL_IDLE_MS=600000

# API Core (Spring Boot en :8080)
RH_API_BASE_URL=http://localhost:8080
RH_INTERNAL_KEY=changeme
RH_API_TIMEOUT_MS=5000
RH_API_MAX_RETRIES=3

# Anonimizacion
PSEUDONYM_SALT=changeme-dev-salt-rehabiapp

# CSFLE (desactivado en desarrollo)
CSFLE_ENABLED=false
CSFLE_KMS_PROVIDER=local

# Puerto del servicio
SERVER_PORT=8081
