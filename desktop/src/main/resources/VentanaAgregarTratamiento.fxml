<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane fitToWidth="true" prefHeight="680.0" prefWidth="560.0" styleClass="root"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javafx.Interface.controladorAgregarTratamiento">
    <VBox alignment="TOP_CENTER" spacing="10.0" styleClass="modal-root">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
        <children>
            <HBox styleClass="modal-header">
                <children>
                    <Label fx:id="lblTituloVentana" styleClass="modal-title" text="Nuevo Tratamiento"/>
                </children>
            </HBox>

            <Separator/>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <Label prefWidth="140.0" text="Codigo:"/>
                    <TextField fx:id="txtCodigo" prefWidth="280.0" promptText="Codigo del tratamiento" styleClass="field-required"/>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <Label prefWidth="140.0" text="Nombre:"/>
                    <TextField fx:id="txtNombre" prefWidth="280.0" promptText="Nombre del tratamiento" styleClass="field-required"/>
                </children>
            </HBox>

            <VBox spacing="3.0">
                <children>
                    <Label text="Definicion:"/>
                    <TextArea fx:id="txtAreaDefinicion" prefHeight="80.0" prefWidth="460.0"
                              promptText="Definicion del tratamiento" wrapText="true"/>
                </children>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <Label prefWidth="140.0" text="Discapacidad:"/>
                    <ComboBox fx:id="cmbDiscapacidad" prefWidth="280.0" promptText="Seleccione discapacidad"/>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <Label prefWidth="140.0" text="Nivel progresion:"/>
                    <ComboBox fx:id="cmbNivelProgresion" prefWidth="280.0" promptText="Seleccione nivel"/>
                </children>
            </HBox>

            <Separator/>

            <!-- C: Videojuegos terapeuticos -->
            <Label text="Videojuegos terapeuticos asociados:" styleClass="label-formulario"/>
            <TableView fx:id="tablaJuegos" prefHeight="160.0" prefWidth="500.0">
                <columns>
                    <TableColumn fx:id="colJuegoSel" prefWidth="50.0" text="Sel"/>
                    <TableColumn fx:id="colJuegoCod" prefWidth="100.0" text="Codigo"/>
                    <TableColumn fx:id="colJuegoNom" prefWidth="210.0" text="Nombre"/>
                    <TableColumn fx:id="colJuegoCue" prefWidth="120.0" text="Parte cuerpo"/>
                </columns>
                <placeholder><Label text="Sin juegos para esta discapacidad"/></placeholder>
            </TableView>

            <Separator/>

            <!-- B: PDF del tratamiento -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <children>
                    <Label text="PDF del tratamiento:" styleClass="label-formulario"/>
                    <Button fx:id="btnImportarPdf" text="Importar PDF"
                            styleClass="button,secondary" onAction="#importarPdf">
                        <graphic><FontIcon iconLiteral="mdi2f-file-pdf-box" iconSize="14" /></graphic>
                    </Button>
                    <Label fx:id="lblNombrePdf" text="(Sin archivo)" styleClass="modal-subtitle"/>
                    <Button fx:id="btnDescargarPdf" text="Descargar"
                            styleClass="button,ghost" onAction="#descargarPdf" visible="false">
                        <graphic><FontIcon iconLiteral="mdi2o-open-in-new" iconSize="14" /></graphic>
                    </Button>
                    <Button fx:id="btnEliminarPdf" text="Quitar"
                            styleClass="button,danger" onAction="#eliminarPdf" visible="false">
                        <graphic><FontIcon iconLiteral="mdi2t-trash-can-outline" iconSize="14" /></graphic>
                    </Button>
                </children>
            </HBox>

            <Separator/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="modal-footer">
                <children>
                    <Button fx:id="btnCancelar" onAction="#cerrarVentana"
                            styleClass="button,ghost" text="Cancelar"/>
                    <Button fx:id="btnGuardar" onAction="#guardarTratamiento"
                            styleClass="button,primary" text="Crear">
                        <graphic><FontIcon iconLiteral="mdi2c-content-save" iconSize="14" /></graphic>
                    </Button>
                </children>
            </HBox>
        </children>
    </VBox>
</ScrollPane>
