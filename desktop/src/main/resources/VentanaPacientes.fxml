<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="vboxContenedorPrinPacientes" maxHeight="Infinity" maxWidth="Infinity" spacing="15.0" styleClass="panel-card" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.Interface.controladorVentanaPacientes">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox prefHeight="100.0" prefWidth="200.0" styleClass="panel-card-header">
            <children>
                <Label fx:id="lblTituloPestaniaPacientes" prefHeight="18.0" prefWidth="200.0" styleClass="label-titulo" text="Pacientes" />
                <VBox prefHeight="100.0" prefWidth="802.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnSeleccionarTodoPacientes" mnemonicParsing="false" onAction="#seleccionarTodosPacientes" text="Seleccionar todo" styleClass="button,ghost">
                            <VBox.margin>
                                <Insets bottom="20.0" left="150.0" />
                            </VBox.margin>
                        </Button>
                        <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="103.0">
                            <children>
                                <Label fx:id="lblBuscarPacientes" text="Buscar:">
                                    <HBox.margin>
                                        <Insets right="10.0" />
                                    </HBox.margin>
                                </Label>
                                <Button fx:id="btnBuscarPacientes" mnemonicParsing="false" onAction="#buscarPacientes" styleClass="button,icon-only">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2m-magnify" iconSize="16" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Buscar" />
                                    </tooltip>
                                </Button>
                                <TextField fx:id="txfBuscarPacientes" onAction="#buscarPacientes" prefHeight="30.0" prefWidth="250.0" promptText="Buscar:">
                                    <padding>
                                        <Insets left="5.0" right="10.0" />
                                    </padding>
                                    <HBox.margin>
                                        <Insets right="50.0" />
                                    </HBox.margin>
                                </TextField>
                                <Button fx:id="btnAnadirPaciente" mnemonicParsing="false" onAction="#abrirFormularioNuevoPaciente" styleClass="button,icon-only,accent">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2p-plus" iconSize="16" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Añadir nuevo paciente" />
                                    </tooltip>
                                    <HBox.margin>
                                        <Insets right="20.0" />
                                    </HBox.margin>
                                </Button>
                                <Button fx:id="btnFiltrarPacientes" mnemonicParsing="false" onAction="#abrirFiltrosPacientes" styleClass="button,icon-only">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2f-filter-variant" iconSize="16" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Filtrar resultados" />
                                    </tooltip>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox alignment="TOP_CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tblPacientes" maxHeight="Infinity" maxWidth="Infinity" prefHeight="479.0" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                        <TableColumn fx:id="colApellidos" prefWidth="230.0" text="Apellidos" />
                        <TableColumn fx:id="colDNI" prefWidth="130.0" text="DNI" />
                        <TableColumn fx:id="colEdad" prefWidth="70.0" text="Edad" />
                        <TableColumn fx:id="colSexo" prefWidth="100.0" text="Sexo" />
                        <TableColumn fx:id="colProtesis" prefWidth="110.0" text="Protesis" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </HBox>
        <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="200.0" spacing="10.0">
            <children>
                <Button fx:id="btnGenerarPDFPaciente" mnemonicParsing="false" onAction="#generarInformePaciente" styleClass="button,ghost" text="Generar listado PDF">
                    <graphic><FontIcon iconLiteral="mdi2f-file-pdf-box" iconSize="14" /></graphic>
                    <tooltip>
                        <Tooltip text="Generar informe PDF del paciente seleccionado" />
                    </tooltip>
                </Button>
                <Button fx:id="btnProgresoPaciente" mnemonicParsing="false" onAction="#abrirProgresoSeleccionado" styleClass="button,secondary" text="Progreso">
                    <graphic><FontIcon iconLiteral="mdi2c-chart-line" iconSize="14" /></graphic>
                    <tooltip>
                        <Tooltip text="Ver progreso clinico del paciente seleccionado" />
                    </tooltip>
                </Button>
                <Button fx:id="btnEliminarPaciente" mnemonicParsing="false" onAction="#eliminarPacienteSeleccionado" styleClass="button,danger" text="Eliminar" textAlignment="CENTER">
                    <graphic><FontIcon iconLiteral="mdi2t-trash-can-outline" iconSize="14" /></graphic>
                </Button>
                <Button fx:id="btnAbrirPaciente" mnemonicParsing="false" onAction="#abrirFichaPaciente" styleClass="button,primary" text="Abrir">
                    <graphic><FontIcon iconLiteral="mdi2o-open-in-new" iconSize="14" /></graphic>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
