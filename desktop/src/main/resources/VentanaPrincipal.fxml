<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="bdpPrincipal" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="750.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.Interface.controladorVentanaPrincipal">

    <top>
        <!-- Topbar nueva: logo sin texto (izda), busqueda centrada con icono mdi2,
             boton perfil redondo a la derecha. Spec §3.3 actualizada — el wordmark
             "RehabiAPP" lo aporta el propio logotipo. -->
        <HBox alignment="CENTER" prefHeight="160.0" minHeight="160.0" spacing="16.0" styleClass="topbar" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="10.0" />
            </padding>
            <children>
                <!-- IZQUIERDA: solo el logotipo sin letras (la marca esta en la propia imagen) -->
                <ImageView fx:id="imgLogoStage" fitHeight="144.0" fitWidth="144.0" pickOnBounds="true" preserveRatio="true" styleClass="logo-image">
                    <image>
                        <Image url="@RehabiAPPLogoNoLetras.png" />
                    </image>
                </ImageView>

                <!-- Spacer izquierdo: empuja la busqueda al centro -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- CENTRO: barra de busqueda rapida -->
                <VBox alignment="CENTER" spacing="4.0" styleClass="topbar-search">
                    <children>
                        <Label fx:id="lblBuscarRapido" styleClass="topbar-search-label" text="Buscar citas por fecha o paciente:" />
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#busquedaRapida" styleClass="button, icon-only, secondary">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2m-magnify" iconSize="20" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Buscar citas" />
                                    </tooltip>
                                </Button>
                                <TextField fx:id="txfBusquedaRapida" minHeight="40.0" prefHeight="40.0" prefWidth="360.0" promptText="Fecha (dd/MM/yyyy) o nombre de paciente..." styleClass="topbar-search-field" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Spacer derecho: empuja el boton perfil a la esquina derecha -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- DERECHA: boton perfil circular con icono mdi2 account-circle -->
                <Button fx:id="btnPerfil" mnemonicParsing="false" onAction="#abrirVentanaPerfil" styleClass="topbar-perfil-button">
                    <graphic>
                        <FontIcon iconLiteral="mdi2a-account-circle" iconSize="28" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Perfil" />
                    </tooltip>
                </Button>
            </children>
        </HBox>
    </top>

    <left>
        <VBox alignment="CENTER" prefHeight="658.0" prefWidth="245.0" spacing="5.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" prefHeight="191.0" prefWidth="179.0" spacing="15.0" styleClass="user-card">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label fx:id="lblNombreUsuario" text="Usuario:">
                            <VBox.margin>
                                <Insets />
                            </VBox.margin>
                        </Label>
                        <Label fx:id="lblNombreTemporal" text="&quot;Nombre&quot;" />
                        <Label fx:id="lblCargo" text="Cargo:" />
                        <Label fx:id="lblCargoTemporal" text="&quot;El cargo&quot;" />
                    </children>
                </VBox>
                <Button fx:id="btnPestaniaCitas" mnemonicParsing="false" onAction="#abrirPestaniaCitas" prefHeight="60.0" prefWidth="225.0" text="Citas" styleClass="nav-item">
                    <graphic><FontIcon iconLiteral="mdi2c-calendar-heart" iconSize="16" /></graphic>
                </Button>
                <Button fx:id="btnPestaniaPacientes" mnemonicParsing="false" onAction="#abrirPestaniaPacientes" prefHeight="60.0" prefWidth="225.0" text="Pacientes" styleClass="nav-item">
                    <graphic><FontIcon iconLiteral="mdi2a-account-plus" iconSize="16" /></graphic>
                </Button>
                <Button fx:id="btnPestaniaSanitarios" mnemonicParsing="false" onAction="#abrirPestaniaSanitarios" prefHeight="60.0" prefWidth="225.0" text="Sanitarios" styleClass="nav-item">
                    <graphic><FontIcon iconLiteral="mdi2s-stethoscope" iconSize="16" /></graphic>
                </Button>
                <Button fx:id="btnPestaniaDiscapacidades" mnemonicParsing="false" onAction="#abrirPestaniaDiscapacidades" prefHeight="60.0" prefWidth="225.0" text="Discapacidades" styleClass="nav-item">
                    <graphic><FontIcon iconLiteral="mdi2w-wheelchair-accessibility" iconSize="16" /></graphic>
                </Button>
                <Button fx:id="btnPestaniaTratamientos" mnemonicParsing="false" onAction="#abrirPestaniaTratamientos" prefHeight="60.0" prefWidth="225.0" text="Tratamientos" styleClass="nav-item">
                    <graphic><FontIcon iconLiteral="mdi2p-pulse" iconSize="16" /></graphic>
                </Button>
                <Button fx:id="btnPestaniaVideojuegos" mnemonicParsing="false" onAction="#abrirPestaniaVideojuegos" prefHeight="60.0" prefWidth="225.0" text="Videojuegos" styleClass="nav-item">
                    <graphic><FontIcon iconLiteral="mdi2c-controller-classic" iconSize="16" /></graphic>
                </Button>
                <Button fx:id="btnPestaniaAyuda" mnemonicParsing="false" onAction="#abrirPestaniaAyuda" prefHeight="60.0" prefWidth="225.0" text="Ayuda" styleClass="nav-item">
                    <graphic><FontIcon iconLiteral="mdi2l-lifebuoy" iconSize="16" /></graphic>
                    <VBox.margin>
                        <Insets />
                    </VBox.margin></Button>
                <HBox alignment="BOTTOM_CENTER" prefHeight="273.0" prefWidth="179.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnAjustes" mnemonicParsing="false" onAction="#abrirVentanaOpciones" styleClass="button,icon-only">
                            <tooltip>
                                <Tooltip text="Ajustes" />
                            </tooltip>
                            <graphic>
                                <FontIcon iconLiteral="mdi2c-cog" iconSize="18" />
                            </graphic>
                            <HBox.margin>
                                <Insets right="10.0" />
                            </HBox.margin></Button>
                        <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#cerrarSesion" styleClass="button,danger">
                            <tooltip>
                                <Tooltip text="Salir" />
                            </tooltip>
                            <graphic>
                                <FontIcon iconLiteral="mdi2l-logout" iconSize="16" />
                            </graphic></Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox fx:id="vboxContenidoPrincipal" alignment="TOP_CENTER" maxHeight="Infinity" maxWidth="Infinity" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
            </padding>
            <children>
                <ImageView fx:id="imgFotoLogoCompletoStage" fitHeight="467.0" fitWidth="463.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <!-- Placeholder central: logo CON letras (marca completa). -->
                        <Image url="@assets/logo.png" />
                    </image>
                    <VBox.margin>
                        <Insets top="50.0" />
                    </VBox.margin>
                </ImageView>
            </children>
        </VBox>
    </center>

</BorderPane>
