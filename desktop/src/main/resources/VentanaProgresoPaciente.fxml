<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javafx.Interface.controladorVentanaProgresoPaciente"
      styleClass="root modal-root"
      prefWidth="900" prefHeight="700" spacing="10">
    <padding>
        <Insets bottom="16" left="16" right="16" top="16"/>
    </padding>
    <children>
        <HBox styleClass="modal-header" spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="lblTituloProgreso" text="Progreso del paciente" styleClass="label-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUltimaActualizacion" text="" styleClass="label-secundario"/>
            <Button fx:id="btnRecargar" text="Actualizar" onAction="#recargar" styleClass="button-secundario"/>
            <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrar" styleClass="button-secundario">
                <HBox.margin><Insets left="8"/></HBox.margin>
            </Button>
        </HBox>
        <ProgressIndicator fx:id="indicadorCarga" visible="false" maxWidth="40" maxHeight="40"/>
        <ScrollPane fx:id="scrollGraficos" fitToWidth="true" VBox.vgrow="ALWAYS">
            <VBox fx:id="contenedorGraficos" spacing="20">
                <padding><Insets bottom="12" left="4" right="4" top="4"/></padding>
            </VBox>
        </ScrollPane>
        <Label fx:id="lblEstado" text="" styleClass="label-secundario"/>
    </children>
</VBox>
