<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox fx:id="vboxContenedorPrinVideojuegos" maxHeight="Infinity" maxWidth="Infinity"
      spacing="15.0" styleClass="panel-card"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javafx.Interface.controladorVentanaVideojuegos">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox prefHeight="100.0" prefWidth="200.0" styleClass="panel-card-header">
            <children>
                <Label fx:id="lblTituloPestaniaVideojuegos" prefHeight="18.0" prefWidth="200.0"
                       styleClass="label-titulo" text="Videojuegos" />
                <VBox prefHeight="100.0" prefWidth="802.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="103.0">
                            <children>
                                <Label text="Buscar:">
                                    <HBox.margin>
                                        <Insets right="10.0" />
                                    </HBox.margin>
                                </Label>
                                <Button fx:id="btnBuscarVideojuegos" mnemonicParsing="false"
                                        onAction="#buscarVideojuegos"
                                        styleClass="button,icon-only">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2m-magnify" iconSize="16" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Buscar" />
                                    </tooltip>
                                </Button>
                                <TextField fx:id="txfBuscarVideojuegos" onAction="#buscarVideojuegos"
                                           prefHeight="30.0" prefWidth="200.0" promptText="Buscar por codigo o nombre">
                                    <padding>
                                        <Insets left="5.0" right="10.0" />
                                    </padding>
                                    <HBox.margin>
                                        <Insets right="10.0" />
                                    </HBox.margin>
                                </TextField>
                                <Label text="Discapacidad:">
                                    <HBox.margin>
                                        <Insets right="5.0" />
                                    </HBox.margin>
                                </Label>
                                <ComboBox fx:id="cmbFiltroDiscapacidad" prefWidth="180.0"
                                          promptText="Todas">
                                    <HBox.margin>
                                        <Insets right="20.0" />
                                    </HBox.margin>
                                </ComboBox>
                                <Button fx:id="btnAnadirVideojuego" mnemonicParsing="false"
                                        onAction="#abrirFormularioNuevoVideojuego"
                                        styleClass="button,icon-only,accent">
                                    <graphic>
                                        <FontIcon iconLiteral="mdi2p-plus" iconSize="16" />
                                    </graphic>
                                    <tooltip>
                                        <Tooltip text="Anadir nuevo videojuego" />
                                    </tooltip>
                                    <HBox.margin>
                                        <Insets right="20.0" />
                                    </HBox.margin>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="TOP_CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tblVideojuegos" maxHeight="Infinity" maxWidth="Infinity"
                           prefHeight="479.0" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Codigo" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colDiscapacidad" prefWidth="180.0" text="Discapacidad" />
                        <TableColumn fx:id="colParteCuerpo" prefWidth="140.0" text="Parte cuerpo" />
                        <TableColumn fx:id="colActivo" prefWidth="80.0" text="Activo" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </HBox>

        <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="200.0" spacing="10.0">
            <children>
                <Button fx:id="btnEliminarVideojuego" mnemonicParsing="false"
                        onAction="#eliminarVideojuegoSeleccionado"
                        styleClass="button,danger" text="Eliminar" textAlignment="CENTER">
                    <graphic><FontIcon iconLiteral="mdi2t-trash-can-outline" iconSize="14" /></graphic>
                </Button>
                <Button fx:id="btnEditarVideojuego" mnemonicParsing="false"
                        onAction="#editarVideojuegoSeleccionado"
                        styleClass="button,primary" text="Editar">
                    <graphic><FontIcon iconLiteral="mdi2p-pencil" iconSize="14" /></graphic>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
