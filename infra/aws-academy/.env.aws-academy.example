# Plantilla de variables de entorno para el deploy AWS Academy.
# Copiar a `.env.aws-academy` y rellenar valores reales.
# Este fichero (.example) si se commitea; .env.aws-academy NO se commitea (gitignored).
#
# Generar secretos aleatorios:
#   openssl rand -base64 32

# ================== RDS PostgreSQL ==================
# Endpoint de la instancia RDS (sin protocolo, sin puerto si es 5432 default).
SPRING_DATASOURCE_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/rehabiapp
SPRING_DATASOURCE_USERNAME=rehabiapp_admin
SPRING_DATASOURCE_PASSWORD=<RDS_PASSWORD>

# ================== Secretos aplicacion ==================
# Clave HMAC-SHA para firma JWT — minimo 32 bytes.
JWT_SIGNING_KEY=<openssl rand -base64 32>
# Clave AES-256-GCM (32 bytes) para cifrado de campos clinicos.
ENCRYPTION_KEY=<openssl rand -base64 32>
# Clave compartida entre /api y /data para auth interna (X-Internal-Key).
RH_INTERNAL_KEY=<openssl rand -base64 32>

# ================== DuckDNS + Let's Encrypt ==================
# Subdominio DuckDNS registrado en https://www.duckdns.org/
DUCKDNS_DOMAIN=rehabiapp-api.duckdns.org
# Token DuckDNS para actualizar la IP (lo da DuckDNS tras login).
DUCKDNS_TOKEN=<DUCKDNS_UUID_TOKEN>
# Email registrado en Let's Encrypt para notificaciones de expiracion.
ACME_EMAIL=tu-email@example.com

# ================== CORS ==================
# Origen principal del juego Unity WebGL alojado en S3.
APP_CORS_ALLOWED_ORIGIN_0=http://s3-bucket-rehabiapp-piano-640681720314.s3-website-us-east-1.amazonaws.com
# Origen adicional opcional (ej. CloudFront, otro bucket de pruebas).
APP_CORS_EXTRA_ORIGIN=
