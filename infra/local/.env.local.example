# Plantilla de variables de entorno para el stack local Docker.
# Copiar a `.env.local` y rellenar valores reales.
# `.env.local` esta en .gitignore (no se commitea).
#
# Generar secretos aleatorios:
#   openssl rand -base64 32

# ================== PostgreSQL local (in-cluster) ==================
# Estos valores se inyectan al servicio rehabiapp-postgres y a la API/chatbot.
POSTGRES_DB=rehabiapp
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# ================== Secretos aplicacion ==================
# Clave HMAC-SHA para firma JWT — minimo 32 bytes. Tambien usada por el BFF.
JWT_SIGNING_KEY=cambiar-por-openssl-rand-base64-32-en-local
# Clave AES-256-GCM (32 bytes) para cifrado de campos clinicos.
ENCRYPTION_KEY=cambiar-por-openssl-rand-base64-32-en-local
# Clave compartida entre /api y /data para auth interna (X-Internal-Key).
RH_INTERNAL_KEY=cambiar-por-openssl-rand-base64-32-en-local

# ================== CORS ==================
# Origenes desde los que la API acepta peticiones cross-origin.
# Para dev local con Expo / Vite anadir los puertos del frontend.
APP_CORS_ALLOWED_ORIGIN_0=http://localhost:5173
APP_CORS_EXTRA_ORIGIN=http://localhost:3000

# ================== Chatbot WhatsApp ==================
# URL del Ollama que corre en el host del dev (laptop).
# host.docker.internal es el gateway docker hacia el host.
CHATBOT_OLLAMA_URL=http://host.docker.internal:11434
CHATBOT_OLLAMA_MODEL=qwen2.5:latest
# Numero WhatsApp del hospital al que se vinculara el bot (formato E.164).
CHATBOT_HOSPITAL_PHONE_E164=+34641710369
